@using MudBlazor
@namespace NorthwindAspire.Frontend.Components.CRUD.Shared

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-3" />
            Confirm Delete
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>
            Are you sure you want to delete this @EntityName? This action cannot be undone.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Confirm">
            Delete
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public dynamic MudDialog { get; set; } = null!;

    [Parameter]
    public string EntityName { get; set; } = "record";

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(true);
}
