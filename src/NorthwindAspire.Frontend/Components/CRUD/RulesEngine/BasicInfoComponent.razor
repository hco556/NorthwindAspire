@using System.Text.Json
@using NorthwindAspire.Frontend.Models.FormModels

@implements IDisposable

<MudPaper Class="pa-3">
    <MudForm @ref="_form" Model="@Model">
        <MudTextField Id="firstName" Label="Name" @bind-Value="Model.Name" Immediate="true" />
        <MudTextField Id="email" Label="Email" @bind-Value="Model.Email" Immediate="true" />
        <MudTextField Id="creditHistory" Label="Credit History" @bind-Value="Model.CreditHistory" Immediate="true" />
        <MudTextField Id="country" Label="Country" @bind-Value="Model.Country" Immediate="true" />
        <MudTextField Id="loyaltyFactor" Label="Loyalty Factor" @bind-Value="Model.LoyaltyFactor" Immediate="true" />
        <MudTextField Id="totalPurchasesToDate" Label="Total Purchases To Date" @bind-Value="Model.TotalPurchasesToDate" Immediate="true" />
        <MudButton  OnClick="OnSave">Save Basic Info</MudButton>
    </MudForm>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string BasicJson { get; set; } = "{}";

    private MudForm? _form;
    private BasicInfoModel Model { get; set; } = new();

    protected override void OnInitialized()
    {
        try
        {
            var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var parsed = JsonSerializer.Deserialize<BasicInfoModel>(BasicJson, opts);
            if (parsed != null) Model = parsed;
        }
        catch
        {
            // ignore parse errors; keep defaults
        }
    }

    private async Task OnSave()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            // persist Model or raise event
        }
    }

    public void Dispose()
    {
        // cleanup if needed
    }
}

